# Copy to .env for local runs. On Render, set these as environment variables.
# Never commit a real .env or service-account file.

# MongoDB. mongodb+srv:// (Atlas) turns TLS on automatically.
MONGO_URI=mongodb://localhost:27017
DB_NAME=exometrics
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Firebase Admin service account: either the file path...
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# ...or the file's whole JSON content in one variable (takes precedence).
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
CHECK_REVOKED_TOKENS=false

# "production" turns the interactive /docs off (override with ENABLE_DOCS=true)
# and HSTS on. On Render it is the default; locally the default is development.
ENVIRONMENT=development
# ENABLE_DOCS=
LOG_LEVEL=INFO

# Exact browser origins allowed by CORS, comma-separated. Leave empty: the
# Android app doesn't use CORS and researchers read the data in Atlas.
CORS_ORIGINS=

# Abuse limits
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=1200
IP_RATE_LIMIT_PER_MINUTE=6000
MAX_BATCH_SIZE=500
